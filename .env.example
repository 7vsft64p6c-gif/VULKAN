# Copia este archivo como .env en la raíz privada del proyecto o un nivel
# por encima del document root. Nunca lo subas ni lo coloques dentro de public/.

APP_ENV=production
APP_BASE_URL=https://tudominio.example
FRONTEND_ORIGIN=

# Los pagos deben permanecer cerrados hasta completar el checklist de
# docs/PAYMENTS.md, pruebas sandbox y aprobación explícita del comercio.
PAYMENTS_ENABLED=false
PAYMENT_PROVIDER=disabled
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_ENVIRONMENT=sandbox
MERCADOPAGO_WEBHOOK_SECRET=

DB_DRIVER=mysql
DB_HOST=localhost
DB_NAME=
DB_USER=
DB_PASS=

# Rutas opcionales fuera de public/. Déjalas comentadas para usar los valores
# seguros por defecto del proyecto; en producción puedes definir rutas absolutas.
# STORAGE_PATH=/ruta/privada/vulkan/storage
# DB_SQLITE_PATH=/ruta/privada/vulkan/storage/vulkan.sqlite

# Importes en céntimos; confírmalos antes de publicar.
SHIPPING_AREQUIPA_CENTS=0
SHIPPING_PROVINCIA_CENTS=1500

STORE_NAME=VULKÁN
STORE_CONTACT_EMAIL=stevebunnies62@gmail.com
SESSION_NAME=vulkan_session
PASSWORD_RESET_EMAIL_ENABLED=false
PASSWORD_RESET_TTL_MINUTES=30

# Reservado para endpoints administrativos futuros.
ADMIN_TOKEN=
